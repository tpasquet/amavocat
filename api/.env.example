# Copy to .env for local development (never commit the real file)
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/amavocat.sqlite
MEDIA_DIR=./data/media
# Public origin of the API, used for uploaded image URLs
PUBLIC_URL=http://localhost:3000
# Comma-separated origins allowed to call the API with cookies (admin app, public site)
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
# Set to true in production (HTTPS only)
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
# Contact form (POST /api/contact): leave SMTP_HOST empty to disable it (it then answers 503)
SMTP_HOST=
# 587 + SMTP_SECURE=false uses STARTTLS (required); 465 + SMTP_SECURE=true uses implicit TLS
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Recipient of the messages, and sender address (must be allowed by the SMTP account)
CONTACT_TO=contact@aureliemanier-avocat.fr
CONTACT_FROM="Site aureliemanier-avocat.fr <contact@aureliemanier-avocat.fr>"
